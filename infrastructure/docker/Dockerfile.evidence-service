# syntax=docker/dockerfile:1
FROM node:20-slim AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
RUN pnpm install --frozen-lockfile && pnpm --filter @truemandate/evidence-service... build
FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production TM_PERSISTENCE=firestore TM_REQUIRE_CONFIG=true TM_SERVICE_NAME=evidence-service
COPY --from=build /app /app
EXPOSE 8080
CMD ["node", "services/evidence-service/dist/bin/start.js"]
