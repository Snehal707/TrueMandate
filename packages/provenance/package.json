{
  "name": "@truemandate/provenance",
  "version": "0.1.0",
  "description": "Provenance graph, taint propagation, and authority path tracing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@truemandate/crypto": "workspace:*",
    "@truemandate/protocol": "workspace:*",
    "@truemandate/schemas": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
