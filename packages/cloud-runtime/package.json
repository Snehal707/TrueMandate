{
  "name": "@truemandate/cloud-runtime",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@opentelemetry/api": "^1.9.1",
    "@truemandate/cloud-firestore": "workspace:*",
    "@truemandate/cloud-pubsub": "workspace:*",
    "@truemandate/cloud-security": "workspace:*",
    "@truemandate/observability": "workspace:*",
    "@truemandate/protocol": "workspace:*"
  },
  "optionalDependencies": {
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0"
  }
}
